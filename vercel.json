{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/build",
  "installCommand": "cd server && npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/books"
    },
    {
      "source": "/books/:path*",
      "destination": "/api/books"
    }
  ]
}
